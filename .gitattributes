* text=auto eol=lf

*.otf   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.png   binary

# AutoHotkey needs its UTF-8 BOM and Windows line endings preserved
*.ahk   text eol=crlf

# Spreadsheets: keep CRLF so Excel opens them cleanly
*.csv   text eol=crlf

# Windows scripts. These are downloaded straight from GitHub Pages rather than
# cloned, and a raw download serves whatever bytes are in the index -- eol=crlf
# would only apply on checkout. So store them verbatim instead.
*.cmd   -text
*.bat   -text
*.ps1   -text
